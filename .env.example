# Leave blank in production so the browser uses the same host as the API.
VITE_VERIFICATION_API_URL=
# Host port used by Docker Compose. Change to 8001 if localhost:8000 is busy.
VERIFICATION_PORT=8000
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=
OPENROUTER_MODEL=google/gemini-3.5-flash
# Docker Compose always uses /data. Leave blank for the direct backend default
# (backend/data), or set another writable local path.
VERIFICATION_DATA_DIR=
# Creates the initial reviewer exactly once. There is no public sign-up route.
# Replace these before exposing the service; do not commit the resulting .env.
VERIFICATION_BOOTSTRAP_USERNAME=admin
VERIFICATION_BOOTSTRAP_PASSWORD=change-this-before-deployment
VERIFICATION_BOOTSTRAP_PASSWORD_FILE=
# Set true when HTTPS terminates in front of the container (Caddy, ALB, etc.).
# Keep false for http://localhost:8000.
VERIFICATION_SESSION_SECURE=false
VERIFICATION_SESSION_HOURS=12
# Concurrent cases, local OCR subprocesses, and outbound vision requests.
# The conservative defaults suit a small two-vCPU host. A multi-panel case can
# still issue up to three vision calls concurrently while OCR remains serial.
VERIFICATION_ANALYSIS_CONCURRENCY=1
VERIFICATION_OCR_CONCURRENCY=1
VERIFICATION_VISION_CONCURRENCY=3
# Optional, allowlisted public reference catalog. Keep blank to hide catalog import.
VERIFICATION_S3_CATALOG_URL=
