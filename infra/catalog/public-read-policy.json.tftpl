{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFrontReadCatalogObjectsOnly",
      "Effect": "Allow",
      "Principal": {"Service": "cloudfront.amazonaws.com"},
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${bucket_name}/catalog/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "${distribution_arn}"
        }
      }
    }
  ]
}
