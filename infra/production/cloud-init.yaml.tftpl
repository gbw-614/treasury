#cloud-config
package_update: true
packages:
  - docker
  - xfsprogs

write_files:
  - path: /etc/treasury/runtime.conf
    owner: root:root
    permissions: "0600"
    content: |
      AWS_REGION='${aws_region}'
      BOOTSTRAP_PASSWORD_PARAMETER_NAME='${bootstrap_password_parameter_name}'
      BOOTSTRAP_USERNAME='${bootstrap_username}'
      CATALOG_URL='${catalog_url}'
      ECR_REGISTRY='${ecr_registry}'
      OPENROUTER_PARAMETER_NAME='${openrouter_parameter_name}'
      OPENROUTER_MODEL='${openrouter_model}'
      SESSION_HOURS='${session_hours}'
      SESSION_SECURE='${session_secure}'

  - path: /etc/treasury/image-ref
    owner: root:root
    permissions: "0644"
    content: |
      ${initial_image_ref}

  - path: /etc/treasury/Caddyfile
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, caddy_global_options)}
      ${caddy_site_address} {
        encode zstd gzip
        reverse_proxy treasury-app:8000
      }

  - path: /usr/local/bin/prepare-treasury-volume
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      TARGET_SERIAL=$(printf '%s' '${data_volume_id}' | tr -d '-')
      DEVICE=''

      for ATTEMPT in $(seq 1 100); do
        DEVICE=$(lsblk -dn -o PATH,SERIAL | awk -v target="$TARGET_SERIAL" '$2 == target { print $1; exit }')
        if [ -n "$DEVICE" ]; then
          break
        fi
        sleep 3
      done

      if [ -z "$DEVICE" ]; then
        echo "Persistent EBS volume ${data_volume_id} was not attached within five minutes" >&2
        exit 1
      fi

      if ! blkid "$DEVICE" >/dev/null 2>&1; then
        mkfs.xfs -f "$DEVICE"
      fi

      FILESYSTEM_UUID=$(blkid -s UUID -o value "$DEVICE")
      install -d -m 0755 /srv/treasury
      if ! grep -q "UUID=$FILESYSTEM_UUID " /etc/fstab; then
        printf 'UUID=%s /srv/treasury xfs defaults,nofail 0 2\n' "$FILESYSTEM_UUID" >> /etc/fstab
      fi
      if ! mountpoint -q /srv/treasury; then
        mount /srv/treasury
      fi

      install -d -m 0755 /srv/treasury/app /srv/treasury/caddy-data /srv/treasury/caddy-config
      chown -R 10001:10001 /srv/treasury/app
      chown -R 1000:1000 /srv/treasury/caddy-data /srv/treasury/caddy-config

  - path: /usr/local/bin/deploy-treasury
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      exec 9>/run/treasury-deploy.lock
      flock -w 600 9

      source /etc/treasury/runtime.conf
      IMAGE_REF=$${1:-$(tr -d '\n' < /etc/treasury/image-ref)}
      if [ -z "$IMAGE_REF" ]; then
        echo "No application image reference was supplied" >&2
        exit 1
      fi

      /usr/local/bin/prepare-treasury-volume
      aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
      docker pull "$IMAGE_REF"
      docker network inspect treasury >/dev/null 2>&1 || docker network create treasury >/dev/null

      install -d -m 0700 /run/treasury
      SECRET_ARGS=()
      if aws ssm get-parameter \
        --region "$AWS_REGION" \
        --name "$BOOTSTRAP_PASSWORD_PARAMETER_NAME" \
        --with-decryption \
        --query 'Parameter.Value' \
        --output text > /run/treasury/bootstrap-password.tmp; then
        mv /run/treasury/bootstrap-password.tmp /run/treasury/bootstrap-password
        chown 10001:10001 /run/treasury/bootstrap-password
        chmod 0400 /run/treasury/bootstrap-password
        SECRET_ARGS+=(
          --mount type=bind,source=/run/treasury/bootstrap-password,target=/run/secrets/bootstrap_password,readonly
          --env VERIFICATION_BOOTSTRAP_PASSWORD_FILE=/run/secrets/bootstrap_password
        )
      else
        rm -f /run/treasury/bootstrap-password.tmp /run/treasury/bootstrap-password
        echo "Bootstrap-password parameter unavailable; a fresh database will not have a login" >&2
      fi

      if aws ssm get-parameter \
        --region "$AWS_REGION" \
        --name "$OPENROUTER_PARAMETER_NAME" \
        --with-decryption \
        --query 'Parameter.Value' \
        --output text > /run/treasury/openrouter.key.tmp; then
        mv /run/treasury/openrouter.key.tmp /run/treasury/openrouter.key
        chown 10001:10001 /run/treasury/openrouter.key
        chmod 0400 /run/treasury/openrouter.key
        SECRET_ARGS+=(
          --mount type=bind,source=/run/treasury/openrouter.key,target=/run/secrets/openrouter_key,readonly
          --env OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_key
        )
      else
        rm -f /run/treasury/openrouter.key.tmp /run/treasury/openrouter.key
        echo "OpenRouter parameter unavailable; OCR-only mode remains usable" >&2
      fi

      docker rm --force treasury-app >/dev/null 2>&1 || true
      docker run --detach \
        --name treasury-app \
        --network treasury \
        --restart unless-stopped \
        --log-opt max-size=10m \
        --log-opt max-file=3 \
        --mount type=bind,source=/srv/treasury/app,target=/data \
        --env VERIFICATION_DATA_DIR=/data \
        --env VERIFICATION_BOOTSTRAP_USERNAME="$BOOTSTRAP_USERNAME" \
        --env VERIFICATION_SESSION_HOURS="$SESSION_HOURS" \
        --env VERIFICATION_SESSION_SECURE="$SESSION_SECURE" \
        --env VERIFICATION_S3_CATALOG_URL="$CATALOG_URL" \
        --env OPENROUTER_MODEL="$OPENROUTER_MODEL" \
        "$${SECRET_ARGS[@]}" \
        "$IMAGE_REF"

      APP_HEALTH=''
      for ATTEMPT in $(seq 1 40); do
        APP_HEALTH=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' treasury-app)
        if [ "$APP_HEALTH" = 'healthy' ] || [ "$APP_HEALTH" = 'running' ]; then
          break
        fi
        if [ "$APP_HEALTH" = 'unhealthy' ] || [ "$APP_HEALTH" = 'exited' ]; then
          break
        fi
        sleep 3
      done
      if [ "$APP_HEALTH" != 'healthy' ] && [ "$APP_HEALTH" != 'running' ]; then
        docker logs --tail 100 treasury-app >&2 || true
        echo "Application container failed health check: $APP_HEALTH" >&2
        exit 1
      fi

      docker pull caddy:2-alpine
      docker rm --force treasury-caddy >/dev/null 2>&1 || true
      docker run --detach \
        --name treasury-caddy \
        --network treasury \
        --restart unless-stopped \
        --log-opt max-size=10m \
        --log-opt max-file=3 \
        --publish 80:80 \
        --publish 443:443 \
        --mount type=bind,source=/etc/treasury/Caddyfile,target=/etc/caddy/Caddyfile,readonly \
        --mount type=bind,source=/srv/treasury/caddy-data,target=/data \
        --mount type=bind,source=/srv/treasury/caddy-config,target=/config \
        caddy:2-alpine

      printf '%s\n' "$IMAGE_REF" > /etc/treasury/image-ref
      docker image prune --force --filter until=168h >/dev/null

  - path: /etc/systemd/system/treasury-data.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Prepare Treasury persistent data volume
      After=local-fs.target
      Before=treasury.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/prepare-treasury-volume
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/treasury.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Treasury label verification containers
      Requires=docker.service treasury-data.service
      After=docker.service treasury-data.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/deploy-treasury
      RemainAfterExit=yes
      TimeoutStartSec=600

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl enable --now docker.service
  - systemctl enable --now amazon-ssm-agent.service
  - systemctl daemon-reload
  - systemctl enable treasury-data.service treasury.service
  - systemctl start treasury-data.service
  - systemctl start treasury.service || true
