          "title": "Localizationid",
          "type": "string"
        },
        "panelId": {
          "title": "Panelid",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "runnerUpSimilarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runnerupsimilarity"
        },
        "similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
