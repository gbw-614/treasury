          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detectedvalue"
        },
        "evidenceBlockIds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidenceblockids",
          "type": "array"
        },
        "evidenceQuote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidencequote"
        },
        "expectedValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expectedvalue"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "fieldId": {
          "title": "Fieldid",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "matchMode": {
          "default": "literal_phrase",
          "enum": [
            "literal_phrase",
            "text",
            "regex",
            "warning"
          ],
          "title": "Matchmode",
          "type": "string"
        },
        "reasonCode": {
          "title": "Reasoncode",
          "type": "string"
        },
        "requiresHumanReview": {
          "title": "Requireshumanreview",
          "type": "boolean"
        }
      },
      "required": [
        "fieldId",
        "label",
        "automatedStatus",
        "expectedValue",
        "detectedValue",
        "evidenceQuote",
        "reasonCode",
        "explanation",
        "requiresHumanReview"
