      "additionalProperties": false,
      "description": "One literal, positioned text block returned in reading order.",
      "properties": {
        "blockId": {
          "title": "Blockid",
          "type": "string"
        },
        "legibility": {
          "enum": [
            "clear",
            "uncertain",
