        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "FieldKey": {
      "enum": [
        "brand_name",
        "class_type",
        "alcohol_content",
        "proof",
        "government_warning_heading",
        "government_warning_body"
      ],
